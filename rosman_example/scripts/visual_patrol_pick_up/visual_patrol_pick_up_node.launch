<?xml version="1.0"?>
<!--巡线抓取-->
<launch>
    <arg name="start"  default="true"/>

    <!--颜色识别节点-->
    <include file="$(find rosman_example)/scripts/color_detection/color_detection_node.launch"/>

    <include file="$(find rosman_bringup)/launch/base.launch"/>

    <!--巡线抓取-->
    <node pkg="rosman_example" type="visual_patrol_pick_up_node.py" name="visual_patrol_pick_up" output="screen">
        <param name="start"  value="$(arg start)"/>
    </node>
</launch>
