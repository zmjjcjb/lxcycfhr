<?xml version="1.0"?>
<!--apriltag追踪-->
<launch>
    <arg name="start"  default="true"/>

    <!--apriltag识别节点-->
    <include file="$(find rosman_example)/scripts/apriltag_detection/apriltag_detection_node.launch"/>

    <include file="$(find rosman_bringup)/launch/base.launch"/>

    <!--apriltag追踪-->
    <node pkg="rosman_example" type="apriltag_track_node.py" name="apriltag_track" output="screen">
        <rosparam file="$(find rosman_example)/config/apriltag_track_pid.yaml" command="load"/>
        <param name="start"  value="$(arg start)"/>
    </node>
</launch>
