#!/usr/bin/env python3
# encoding: utf-8
# @data:2023/07/04
# @author:aiden
# Hurdling(跨栏)
import time
import rospy
import signal
from rosman_sdk import common
from rosman_example.color_common import Common
from rosman_example.approach_object import ApproachObject
from rosman_interfaces.srv import SetString
from rosman_interfaces.msg import ObjectsInfo, ColorDetect

class HurdlesNode(Common):
    #  Define the ROI (Region of Interest) for color recognition in hurdles task(定义跨栏颜色识别的ROI区域)
    hurdles_roi = [1 / 5, 1, 0, 1]
    #  Define the action name for hurdling(定义跨栏动作的名称)
    hurdles_action_name = 'hurdles'
    # Define the image processing resolution for color recognition(定义颜色识别的图像处理分辨率)
    image_process_size = [160, 120]
    # Define the stop condition for the robot during hurdling(定义跨栏时的机器人停止条件)
    hurdles_x_stop = 395/480
    hurdles_y_stop = 0.5
    hurdles_yaw_stop = 0

    def __init__(self, name):
        # Initialization of the node(初始化节点)
        rospy.init_node(name)
        self.name = name
        self.running = True
        self.objects_info = []
        self.current_state = 'hurdles'
        # Define the state machine, including the initial head posture, color recognition parameters, and whether it is completed(定义状态机,包括初始头部姿态,颜色识别参数,是否完成)
        self.state = {'hurdles': [[500, 260], ['blue', self.hurdles_roi, self.image_process_size, self.set_hurdles_color], False]}
        # Get the initial head posture from the state machine(获取状态机中的初始头部姿态)
        self.head_pan_init = self.state[self.current_state][0][0]   # The initial value of the left-right servo(左右舵机的初始值)
        self.head_tilt_init = self.state[self.current_state][0][1]  # The initial value of the up-down servo(上下舵机的初始值)
        # Initialize the parent class and set the initial head posture(初始化父类,设置初始头部姿态)
        super().__init__(name, self.head_pan_init, self.head_tilt_init)
        # Create an instance for target approaching(创建接近对象实例)
        self.approach_object = ApproachObject(self.gait_manager)
        # Update the approach stop conditions of the ApproachObject object(更新ApproachObject对象的接近停止条件)
        # The threshold of the x-axis distance to approach the target center in units of cm(x_approach_value: 接近目标中心x轴距离的阈值,单位厘米)
        # The threshold of approaching target yaw angle error in units of degrees(yaw_approach_value: 接近目标航向角误差的阈值,单位度)
        self.approach_object.update_approach_stop_value(x_approach_value=35, yaw_approach_value=5)
        
        signal.signal(signal.SIGINT, self.shutdown) # Set exit signal processing function(设置退出信号处理函数)

        # Subscribe to color detection result(订阅颜色识别结果)
        rospy.Subscriber('/object/pixel_coords', ObjectsInfo, self.get_color_callback)
        rospy.Service('~set_color', SetString, self.set_color_srv_callback)  # Set color(设置颜色)
        self.motion_manager.run_action('hand_back')  # Play action of returning the robotic arm back(播放收回手臂动作)
        if rospy.get_param('~start', True):
            self.enter_func(None)
            self.start_srv_callback(None)  # Start color recognition(开启颜色识别)
            common.loginfo('start hurdles')
    # Close node callback function(关闭节点回调函数)
    def shutdown(self, signum, frame):
        self.running = False
        common.loginfo('%s shutdown' % self.name)

    def set_hurdles_color(self, color, roi, image_process_size):
        # Set step flag color(设置台阶标志颜色)
        hurdles_param = ColorDetect()
        hurdles_param.color_name = color
        hurdles_param.detect_type = 'side'
        hurdles_param.use_name = True
        hurdles_param.image_process_size = image_process_size
        hurdles_param.roi.y_min = int(roi[0] * image_process_size[1])
        hurdles_param.roi.y_max = int(roi[1] * image_process_size[1])
        hurdles_param.roi.x_min = int(roi[2] * image_process_size[0])
        hurdles_param.roi.x_max = int(roi[3] * image_process_size[0])
        hurdles_param.min_area = 10 * 20
        hurdles_param.max_area = image_process_size[0] * image_process_size[1]

        return hurdles_param

    def set_color_srv_callback(self, msg):
        # Set color service callback function(设置颜色服务回调函数)
         # Generate color recognition parameter(生成颜色识别参数)
        hurdles_param = self.set_hurdles_color(msg.data)
        # Publish the set color recognition parameters(发布设置的颜色识别参数)
        self.detect_pub.publish([hurdles_param])
        common.loginfo('%s set_color' % self.name)

        return [True, 'set_color']

    def get_color_callback(self, msg):
        # Obtain color recognition result(获取颜色识别结果)
        self.objects_info = msg.data

    def hurdles_process(self, hurdles_data):
        # Hurdling processing function(跨栏处理函数)
        
        # Call the process function for approaching object to control the robot to move(调用接近对象的过程函数,控制机器人移动)
        if self.approach_object.process(max(hurdles_data.y, hurdles_data.left_point[1], hurdles_data.right_point[1]), hurdles_data.x, hurdles_data.angle, 
                                   self.hurdles_x_stop*hurdles_data.height, self.hurdles_y_stop*hurdles_data.width, self.hurdles_yaw_stop, hurdles_data.width, hurdles_data.height):
            self.gait_manager.disable()  #If approaching successfully, stop moving and play action (如果接近成功,停止运动,播放动作)
            common.loginfo('hurdles')
            self.motion_manager.run_action(self.hurdles_action_name)
            return True
        return False

    def run(self):
        while self.running:
            if self.start:  # If turn on start(如果打开start开关)
                if self.state[self.current_state][2] == False:  # If the current state is not completed(如果当前状态尚未完成)
                    self.state[self.current_state][2] = True
                    self.init_action(self.state[self.current_state][0][0], self.state[self.current_state][0][1])  # Head posture(头部姿态)
                    # Generate color recognition parameter(生成颜色识别参数)
                    param = self.state[self.current_state][1][3](self.state[self.current_state][1][0],
                                                                 self.state[self.current_state][1][1],
                                                                 self.state[self.current_state][1][2])
                    self.detect_pub.publish([param])  # Publish color recognition parameter(发布颜色识别参数)

                # Obtain recognition result(获取识别结果)
                hurdles_data = None
                for object_info in self.objects_info:
                    if object_info.type == 'side':
                        hurdles_data = object_info
                # If there is recognition result, and it is in the state of hurdling(如果有识别结果,并且是在跨栏状态)
                if hurdles_data is not None and self.current_state == 'hurdles':
                    if self.hurdles_process(hurdles_data):   # Call hurdling processing function(调用跨栏处理函数)
                        self.running = False
                    else:
                        time.sleep(0.8)
                time.sleep(0.01)
            else:
                time.sleep(0.01)
        # Action before exiting(退出前动作)
        self.init_action(self.head_pan_init, self.head_tilt_init)
        self.stop_srv_callback(None)
        rospy.signal_shutdown('shutdown')

if __name__ == "__main__":
    HurdlesNode('hurdles').run()
