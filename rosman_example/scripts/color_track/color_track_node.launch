<?xml version="1.0"?>
<!--颜色追踪-->
<launch>
    <arg name="color"  default="blue"/>
    <arg name="start"  default="true"/>

    <!--颜色识别节点-->
    <include file="$(find rosman_example)/scripts/color_detection/color_detection_node.launch"/>

    <include file="$(find rosman_bringup)/launch/base.launch"/>

    <!--颜色追踪-->
    <node pkg="rosman_example" type="color_track_node.py" name="color_track" output="screen">
        <rosparam file="$(find rosman_example)/config/color_track_pid.yaml" command="load"/>
        <param name="start"  value="$(arg start)"/>
        <param name="color"  value="$(arg color)"/>
    </node>
</launch>
